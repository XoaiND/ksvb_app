# Bí mật cho docker compose. Chép thành .env (cùng thư mục) rồi điền giá trị thật.
# File .env KHÔNG được commit (.gitignore đã chặn).

# Mật khẩu tài khoản Postgres ksvb_app (bắt buộc)
KSVB_DB_PASSWORD=

# (Tuỳ chọn) URL public của Keycloak và KSVB
# KSVB_KEYCLOAK_PUBLIC_URL=https://sso.xoaind.io.vn
# KSVB_PUBLIC_URL=https://ksvb.xoaind.io.vn
# (Tuỳ chọn) bật Swagger ở prod
# KSVB_API_DOCS_ENABLED=false
