# Bien cho docker compose. Chep thanh .env (cung thu muc) roi dien gia tri that. File .env KHONG commit.

# Postgres (container postgres trong network local-network)
KSVB_DB_URL=jdbc:postgresql://postgres:5432/ksvb
KSVB_DB_USER=ksvb_app
KSVB_DB_PASSWORD=

# Keycloak: issuer = dia chi trinh duyet thay (claim iss), JWK = dia chi noi bo trong Docker
KSVB_OIDC_ISSUER_URI=https://sso.xoaind.io.vn/realms/dev
KSVB_OIDC_JWK_SET_URI=http://keycloak:8080/realms/dev/protocol/openid-connect/certs
KSVB_CORS_ORIGINS=http://localhost:3001

# Frontend (build arg)
VITE_KEYCLOAK_URL=https://sso.xoaind.io.vn
VITE_KEYCLOAK_REALM=dev
VITE_KEYCLOAK_CLIENT_ID=ksvb-web
