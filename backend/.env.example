# Bí mật khi chạy backend trên máy (./mvnw spring-boot:run / IntelliJ, thư mục làm việc = backend/).
# Chép thành backend/.env rồi điền giá trị thật. File .env KHÔNG được commit.
# Biến môi trường thật (nếu có) sẽ đè lên giá trị trong file này.

# Mật khẩu tài khoản Postgres ksvb_app (bắt buộc)
KSVB_DB_PASSWORD=

# (Tuỳ chọn) dev không Keycloak + dữ liệu mẫu trên DB trống
# KSVB_SECURITY_ENABLED=false
# KSVB_SEED_DEMO=true
