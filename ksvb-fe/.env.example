# Chep thanh .env.local (khong commit) khi chay npm run dev.
VITE_KEYCLOAK_URL=https://sso.xoaind.io.vn
VITE_KEYCLOAK_REALM=dev
VITE_KEYCLOAK_CLIENT_ID=ksvb-web
# Mac dinh /api (dev proxy -> 127.0.0.1:8082)
VITE_API_BASE_URL=/api
# true: bo qua dang nhap (chi dev, backend phai chay KSVB_SECURITY_ENABLED=false); gui X-User-Id = VITE_DEV_USER_ID
VITE_AUTH_DISABLED=false
VITE_DEV_USER_ID=4
